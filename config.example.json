  "serial_reconnect_interval_s": 2.0,
  "state_file": "runtime/bridge-state.json",
  "log_limit": 250,
  "ui_refresh_ms": 250,
  "ack_debounce_ms": 250,
  "bridge_heartbeat_interval_s": 2.0,
  "queue_cleanup_enabled": true
}
