{
  "firebase_credentials_path": "/home/pi/secrets/firebase-service-account.json",
  "firebase_database_url": "https://your-project-default-rtdb.firebaseio.com",
  "firebase_commands_path": "/bridges/default/commands",
  "firebase_state_path": "/bridges/default/state",
  "serial_port": "/dev/ttyACM0",
  "serial_baudrate": 115200,
  "serial_write_timeout_s": 1.0,
